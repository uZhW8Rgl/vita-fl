; Master Thesis ChestMNIST inference request and response, version 1.
; Both are deterministic-CBOR closed maps.

inference-request = {
  1: 1,                         ; protocol version
  2: bytes .size 16,            ; request identifier
  3: bytes .size 32,            ; model manifest SHA-256
  4: bytes .size 784,           ; row-major 28 x 28 uint8 pixels
  5: bytes .size 32,            ; client nonce
  6: uint                       ; Unix timestamp in milliseconds
}

inference-response = {
  1: 1,                         ; protocol version
  2: bytes .size 16,            ; request identifier copied from request
  3: bytes .size 32,            ; SHA-256 of exact request CBOR bytes
  4: bytes .size 32,            ; model manifest SHA-256
  5: bytes .size 56,            ; 14 IEEE-754 binary32 logits, little-endian
  6: bytes .size 56,            ; 14 IEEE-754 binary32 probabilities, little-endian
  7: bytes .size 14,            ; one 0x00/0x01 decision per label
  8: uint                       ; inference duration in microseconds
}

