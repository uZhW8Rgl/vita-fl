; Master Thesis ChestMNIST model manifest, version 1.
; Maps use integer keys and are closed: no keys beyond those listed are valid.

model-manifest = {
  1: 1,                         ; manifest format version
  2: tstr,                      ; stable model identifier
  3: tstr,                      ; model version / DFL round identifier
  4: artifact,
  5: provenance,
  6: tensor-contract,
  7: preprocessing,
  8: decision-rule,
  9: [14*14 label]
}

artifact = {
  1: "aggregated.bin",
  2: "application/vnd.master-thesis.dfl-model",
  3: bytes .size 32,            ; SHA-256 of exact native model bytes
  4: uint,                      ; native model byte length
  5: "float64-le-v1"           ; ordered MODEL_LAYOUT tensors
}

provenance = {
  1: uint,                      ; EVM chain identifier
  2: bytes .size 20,            ; GMStorage contract address
  3: uint,                      ; DFL aggregation round
  4: tstr,                      ; content identifier (CID)
  5: bytes .size 32             ; SHA-256 of aggregated DFL model bytes
}

tensor-contract = {
  1: "input",
  2: "float64",
  3: [1, 784],
  4: "logits",
  5: "float64",
  6: [1, 14],
  7: "row-major"
}

preprocessing = {
  1: "uint8-grayscale",
  2: [28, 28, 1],
  3: "row-major-hwc",
  4: "(float64(pixel)-127.5)/127.5",
  5: "float64-native-pytorch"
}

decision-rule = {
  1: "multilabel",
  2: "sigmoid",
  3: "greater-than-or-equal",
  4: 500000                    ; threshold 0.5 in millionths
}

label = tstr
