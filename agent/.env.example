# Local IPFS API, not the browser web UI URL.
IPFS_API_URL=http://127.0.0.1:5001

# On-chain source of truth for the current global model.
AGENT_SOURCE=contract
RPC_URL=http://127.0.0.1:8545
GM_STORAGE_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# MFS path or immutable IPFS path to scan.
# Only used with AGENT_SOURCE=ipfs-scan.
# Use "/" for MFS root, or "/ipfs/<cid>" for an immutable DAG.
IPFS_ROOT=/

# Optional for the LangChain LLM mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

# Defaults used by the local ZK MCP tools.
AGENT_DOWNLOAD_DIR=agent/downloads
AGENT_PAIR_WINDOW_SECONDS=120
ZK_WORKDIR=zk_inference/out
ZK_QUERY_DIR=zk_inference/single_query

# Combined TEE inference + local AIR/TDX evidence verification MCP tool.
TEE_INFERENCE_URL=https://181195df89a143ecaf3d38b2cf0fcb8a30310f07-8080.dstack-pha-prod9.phala.network
TEE_INFERENCE_IMAGE_DIGEST=sha256:34bae2ce708d2c481bb6147a8d7a13711aac44bbadace52102f071545527dcd0
CHESTMNIST_TEST_DATA=data/chestmnist/test_data/test-data.npz
TEE_INFERENCE_EVIDENCE_PATH=tee_inference/out/latest-evidence.cbor

# SCITT-CCF registration performed by the same fail-closed MCP tool.
SCITT_URL=https://127.0.0.1:8000
# Development only: accept the Virtual Mode service's self-signed TLS cert.
SCITT_DEVELOPMENT=1
SCITT_SIGNER_DIR=agent/state/scitt
SCITT_TRANSPARENT_STATEMENT_PATH=tee_inference/out/latest-transparent-statement.cose
