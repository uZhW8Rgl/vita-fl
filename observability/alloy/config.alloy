logging {
  level  = "warn"
  format = "logfmt"
}

loki.source.file "smart_contracts" {
  targets = [
    {
      __path__ = "/runtime-logs/smart-contracts.log",
      job      = "smart-contracts",
      service  = "smart-contracts",
    },
  ]
  tail_from_end = false
  forward_to    = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "1s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
