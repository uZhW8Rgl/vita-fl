# Copy this versioned local-evaluation template to `.env.evaluation`.
TRAINING_ENV_FILE=.env.evaluation
TRAINING_COMPOSE_ENV_FILE=.env.evaluation

# IPFS provider selection: use exactly one mode
API_KEY=
API_SECRET=
PINATA_JWT=
IPFS_GATEWAY=http://ipfs_local:8080

INITIAL_GM_CID=bafybeigjcypobmn3zna5tlaohmfydpdb7tgzges2mrh7l2er42uja4zj6a
INITIAL_GM_SIG_CID=bafkreib3cdvk7qgy6xq6f3ytakiqu3xytarazl4jnyu2pj3m3rzhr6w4ty
INITIAL_GM_SIGNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
CLIENT_LIMIT=24
MODEL_SUBMISSION_DEADLINE_MS=180000
GM_UPDATE_TIMEOUT_MS=90000
GM_UPDATE_TIMEOUT_LOOPS=4
AGGREGATION_UPDATE_ESTIMATE_MS=90000
GM_UPDATE_POLL_MS=5000
MODEL_TRANSFER_TIMEOUT_MS=60000
MODEL_TRANSFER_RETRY_DELAY_MS=5000
AGGREGATOR_TIMEOUT_REPORT_PERCENT=50
EPOCH=2
ROUND=50
WORKER_COUNT=25
ETH_EUR_PRICE=3000
DFL_EXPERIMENT_ID=local
DFL_EVAL_WRITE_SAMPLE_METRICS=1
DFL_MODEL_SEED=42
DFL_TRAIN_SEED=42
# ChestMNIST configuration for the local 25-worker evaluation.
DFL_TRAIN_OPTIMIZER=adamw
DFL_TRAIN_LEARNING_RATE=0.003
DFL_TRAIN_LR_SCHEDULE=late_cosine
DFL_TRAIN_LR_DECAY_START_ROUND=20
DFL_TRAIN_LR_FINAL_FACTOR=0.25
DFL_TRAIN_WEIGHT_DECAY=0.0001
DFL_GRAD_CLIP_NORM=5
DFL_POS_WEIGHT_CAP=10
DFL_THRESHOLD_MAX_PREVALENCE_MULTIPLIER=2
# Limit every local worker to one Torch compute pool in multi-container Docker runs.
DFL_TORCH_NUM_THREADS=1
DFL_TORCH_INTEROP_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
IPFS_PROVIDER=kubo
# For `IPFS_PROVIDER=kubo`, use the local Kubo API/gateway.
# For `IPFS_PROVIDER=pinata`, set `IPFS_GATEWAY` to your Pinata gateway and provide `PINATA_JWT`.
#DOCKER=phala
DOCKER=local
KUBO_API=http://ipfs_local:5001
KUBO_GATEWAY=http://ipfs_local:8080
IPFS_FETCH_TIMEOUT_MS=30000

# Anvil deployed contract addresses
REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
AGGREGATOR_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
GM_STORAGE_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
RPC_URL= http://anvil:8545 #http://host.docker.internal:8545 #http://localhost:8545
ANVIL_HARDFORK=osaka
P256_MODE=native
P256_VERIFIER_ADDRESS=
PCCS_FMSPC=20A06F000000
PCCS_FETCH=1
PCCS_TEE=tdx
PCCS_QUOTE_PATH=../data/phala_tdx_quote
DEPLOY_TDX_V4_DCAP=1
VERIFY_TDX_QUOTE_ONCHAIN=1
KEEP_ALIVE=0
GRAFANA_CONTAINER_NAME=master-thesis-grafana
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_HOST_PORT=3300
UI_BIND_ADDRESS=0.0.0.0
UI_HOST_PORT=8089
DATASET_NAME=chestmnist
TDX_QUOTE_PATH=./attestation/phala_tdx_quote
TDX_REFERENCE_QUOTE_PATH=../data/phala_tdx_quote
PHALA_COMPOSE_PATH=../phala/dstack-compose.template.yml
PHALA_APP_CODE_PATH=../phala/app_code.txt
PHALA_RTMR3_EVENT_LOG_PATH=../phala/rtmr3_event_log.txt

ANVIL_ACCOUNT_COUNT=25


