# Copy to the ignored .env.phala.anvil file and replace every placeholder.
# Never commit the populated file.
PHALA_CLOUD_API_KEY=REPLACE_WITH_PHALA_API_KEY
ETH_WALLET_PRIVATE_KEY=REPLACE_WITH_RUNTIME_OWNER_PRIVATE_KEY

BLOCKCHAIN_PROVIDER=anvil
RPC_URL=http://anvil:8545
ANVIL_HARDFORK=osaka
P256_MODE=fallback
P256_VERIFIER_ADDRESS=
PCCS_FMSPC=20A06F000000
KEEP_ALIVE=0

INITIAL_GM_CID=bafybeigjcypobmn3zna5tlaohmfydpdb7tgzges2mrh7l2er42uja4zj6a
INITIAL_GM_SIG_CID=bafkreib3cdvk7qgy6xq6f3ytakiqu3xytarazl4jnyu2pj3m3rzhr6w4ty
INITIAL_GM_SIGNER_ADDRESS=REPLACE_WITH_WORKER_0_ADDRESS

CLIENT_LIMIT=2
MODEL_SUBMISSION_DEADLINE_MS=20000
GM_UPDATE_TIMEOUT_MS=30000
GM_UPDATE_TIMEOUT_LOOPS=2
AGGREGATION_UPDATE_ESTIMATE_MS=30000
GM_UPDATE_POLL_MS=5000
AGGREGATOR_TIMEOUT_REPORT_PERCENT=50
EPOCH=1
ROUND=5
IPFS_PROVIDER=kubo
DOCKER=phala
IPFS_FETCH_TIMEOUT_MS=30000
MODEL_TRANSFER_TIMEOUT_MS=20000
MODEL_TRANSFER_RETRY_DELAY_MS=5000
ENABLE_AGENT=0
ENABLE_ZK_INFERENCE=0
WORKER_COUNT=3
# The example contains W0-W2. The populated prototype file may raise this to 20.
MAX_DYNAMIC_WORKERS=3
# Set this to true only after publishing the Control API image and replacing
# the example values below. The worker identities remain the fixed W0-W19
# entries from this file; no keys are generated by Terraform or the API.
ENABLE_PHALA_CONTROL_API=false
CONTROL_API_IMAGE=ghcr.io/uzhw8rgl/master-thesis-control-api@sha256:REPLACE_WITH_CONTROL_API_DIGEST
CONTROL_ADMIN_TOKEN=replace-with-at-least-16-characters
ANVIL_ACCOUNT_COUNT=20
DATASET_NAME=chestmnist

# Optional stable endpoint override for an existing contract-runtime app.
PHALA_RUNTIME_ENDPOINT_OVERRIDE=

# Worker 0
W0_ACCOUNT_ADDRESS=REPLACE_WITH_WORKER_0_ADDRESS
W0_PRIVATE_KEY=REPLACE_WITH_WORKER_0_PRIVATE_KEY
W0_DEVICE_ID=0
W0_RSA_PRIVATE_KEY_FILE=data/rsa_keys/private_key.pem
W0_RSA_PUBLIC_KEY_FILE=data/rsa_keys/public_key.pem

# Worker 1
W1_ACCOUNT_ADDRESS=REPLACE_WITH_WORKER_1_ADDRESS
W1_PRIVATE_KEY=REPLACE_WITH_WORKER_1_PRIVATE_KEY
W1_DEVICE_ID=1
W1_RSA_PRIVATE_KEY_FILE=data/rsa_keys/private_key_1.pem
W1_RSA_PUBLIC_KEY_FILE=data/rsa_keys/public_key_1.pem

# Worker 2
W2_ACCOUNT_ADDRESS=REPLACE_WITH_WORKER_2_ADDRESS
W2_PRIVATE_KEY=REPLACE_WITH_WORKER_2_PRIVATE_KEY
W2_DEVICE_ID=2
W2_RSA_PRIVATE_KEY_FILE=data/rsa_keys/private_key_2.pem
W2_RSA_PUBLIC_KEY_FILE=data/rsa_keys/public_key_2.pem
