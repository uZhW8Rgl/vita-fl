  "source_name": "TimeoutGasProbe.sol",
  "source": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.19;\n\n// Minimal integration fixture for the production timeout call's time guard.\ncontract TimeoutGasProbe {\n    uint256 public immutable deadline;\n    address public immutable aggregator;\n    uint256 public reports;\n\n    constructor(uint256 deadline_, address aggregator_) {\n        deadline = deadline_;\n        aggregator = aggregator_;\n    }\n\n    function reportAggregatorTimeout(uint256 expectedRound, address expectedAggregator) external {\n        require(expectedRound == 1 && expectedAggregator == aggregator, \"wrong timeout context\");\n        require(block.timestamp > deadline, \"submission window is still active\");\n        reports++;\n    }\n\n    function getCurrentAggregator() external view returns (address) {\n        return aggregator;\n    }\n}\n",
