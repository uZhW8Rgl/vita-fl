          <mxGeometry x="100" y="110" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="stateMachine()&#xa;while getRound() &lt; ROUND&#xa;read state = getCurrentState()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="190" height="90" as="geometry" />
        </mxCell>
