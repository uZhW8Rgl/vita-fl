        <mxCell id="title" value="node_server/dist/server.js&#xa;State machine and helper flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="420" height="40" as="geometry" />
