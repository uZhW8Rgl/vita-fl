          <mxGeometry x="880" y="860" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="helperSignal" value="Shutdown handlers&#xa;on SIGINT / SIGTERM:&#xa;- kill aggregatorProc if present&#xa;- exit(0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
