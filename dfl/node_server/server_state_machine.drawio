          <mxGeometry x="1270" y="505" width="120" height="90" as="geometry" />
        </mxCell>
        <mxCell id="phalaQuote" value="Optional TDX flow&#xa;- DstackClient.info()&#xa;- getQuote(applicationData)&#xa;- log quote / TCB info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1450" y="470" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sendModel" value="Send local model&#xa;- worker sends signed package&#xa;- aggregator verifies identity, signature, and actual bytes&#xa;- aggregator records SHA-256(bytes) and increments that worker's score atomically&#xa;- on error: return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1450" y="610" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="waitGm" value="Wait for next global model&#xa;- waitForGMUpdate(prevGM, 30s)&#xa;- timeout only warns&#xa;- sleep(2s)&#xa;- continue loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1740" y="620" width="220" height="110" as="geometry" />
        </mxCell>
