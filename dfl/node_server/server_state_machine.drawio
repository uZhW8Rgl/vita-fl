          <mxGeometry x="1010" y="390" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="localTrain" value="Local training&#xa;- run Python train EPOCH aggregatorPubKey&#xa;- on error: return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="500" width="220" height="100" as="geometry" />
        </mxCell>
