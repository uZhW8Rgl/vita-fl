        </mxCell>
        <mxCell id="aggFlow" value="Aggregation flow&#xa;- waitForModels(CLIENT_LIMIT)&#xa;- stop aggregator server&#xa;- stageAggregation()&#xa;- if count == 0: sleep + continue&#xa;- Python aggregates received `.bin` files&#xa;- setCurrentState(&quot;UPDATING&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="updatingCheck" value="UPDATING&#xa;am I aggregator?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="340" y="740" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="updateFlow" value="Update flow&#xa;- updateGM() publishes model, signature, and key bundle&#xa;- stageCleaning()&#xa;- incrementRound() finalizes publication and rewards aggregator once&#xa;- triggerAggregatorSelection() after completed round&#xa;- continue loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="560" y="740" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="defaultState" value="Default / unknown state&#xa;- log unknown state&#xa;- currentState = IDLE&#xa;- sleep(2s)&#xa;- continue loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="end" value="Loop ends when&#xa;getRound() &gt;= ROUND" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="930" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="helperSig" value="Helper: verifyDownloadedGlobalModelSignature()&#xa;1. DER hex -&gt; buffer&#xa;2. read gm.bin and gm.bin.sig&#xa;3. parse SPKI public key&#xa;4. crypto.verify(RSA-SHA256)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="170" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="helperStage" value="Helper: stageAggregation()&#xa;1. ensure `data/results_iid` exists&#xa;2. delete old `.bin` files there&#xa;3. read `received_models`&#xa;4. rehash each file and compare its aggregator-confirmed on-chain record&#xa;5. stage only matching files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="720" width="280" height="120" as="geometry" />
        </mxCell>
