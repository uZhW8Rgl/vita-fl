services:
  zk-inference:
    image: ${zk_inference_image}
    restart: unless-stopped
    ports:
      - "8092:8090"
    environment:
      DOCKER: phala
      DATASET_NAME: chestmnist
      ACCOUNT_ADDRESS: "${account_address}"
      RSA_PRIVATE_KEY: "$${RSA_PRIVATE_KEY}"
      RSA_PUBLIC_KEY: "$${RSA_PUBLIC_KEY}"
      RPC_URL: "${rpc_url}"
      KUBO_API: "${kubo_api_url}"
      KUBO_GATEWAY: "${kubo_gateway_url}"
      ZK_INFERENCE_HOST: 0.0.0.0
      ZK_INFERENCE_PORT: "8090"
      ZK_RUNTIME_DIR: /work/zk-inference
      EZKL_NUM_INNER_COLS: "4"
      EZKL_MAX_LOGROWS: "16"
      RAYON_NUM_THREADS: "1"
      MALLOC_ARENA_MAX: "2"
      SELLO_REQUIRED: "${sello_required}"
      SELLO_SERVICE_SIGNING_SEED: "$${SELLO_SERVICE_SIGNING_SEED}"
      SELLO_TOKEN_ISSUER_PUBLIC_KEY: "$${SELLO_TOKEN_ISSUER_PUBLIC_KEY}"
      SCITT_URL: "${sello_scitt_url}"
      SCITT_DEVELOPMENT: "1"
      SCITT_SIGNER_DIR: /tmp/zk-inference-scitt-signer
      SELLO_PUBLICATION_DIR: /tmp/zk-inference-sello-publications
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "http://127.0.0.1:8090/health"]
      interval: 15s
      timeout: 5s
      start_period: 30s
      retries: 20
