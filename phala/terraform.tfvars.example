# Minimal Phala configuration.
# Defaults already cover:
# - contracts_size = "tdx.small"
# - worker_size    = "tdx.small"
# - region    = "US-WEST-1"
# - os_image  = "dstack-dev-0.5.7-9b6a5239"
# - contracts_disk_size = 20
# - worker_disk_size    = 20
# - worker_replicas = 1

account_address             = "0xYOUR_WORKER_ADDRESS"
rsa_private_key_path        = "../data/rsa_keys/private_key.pem"
rsa_public_key_path         = "../data/rsa_keys/public_key.pem"
initial_gm_signing_key_path = "../data/rsa_keys/private_key.pem"

# Do not put wallet or RSA private-key contents in this file. Supply the
# sensitive wallet input with TF_VAR_private_key or use phala/tf-env.sh.

# Optional overrides:
# contracts_app_name = "master-thesis-contract-runtime-phala"
# worker_app_name    = "master-thesis-dfl-worker-0"
# worker_replicas    = 1
# worker_image     = "ghcr.io/uzhw8rgl/master-thesis-dfl-worker@sha256:8b642b56dff2121f9ff4cd9102af3886ae444a8bca4ae96449b19f72859a32ff"
# smart_contracts_image = "ghcr.io/uzhw8rgl/master-thesis-smart-contracts@sha256:70b65f1c30b5bdf8d50dd3ce01800e5615e5900d500a06be2dbbfdedb606d202"
# control_api_image = "ghcr.io/uzhw8rgl/master-thesis-control-api@sha256:94ffe549227695c78c71b22d29c091acb3d99426b6ced3a413c19e539af4d779"
# ui_image = "ghcr.io/uzhw8rgl/master-thesis-ui@sha256:ce436e9bdc096ee2e485218c5709e784452bd5696b0bdee8e99cc7e68a04250f"
# ui_basic_auth_username = "operator"
# ui_basic_auth_password = "replace-with-at-least-16-characters"
# enable_tee_inference = true
# tee_inference_image = "ghcr.io/uzhw8rgl/master-thesis-tee-inference@sha256:cf78b6b5515f0d8d61ecb22612088db9dccf43dcd9311783239a30c90dd4054a"
# enable_zk_inference = true
# zk_inference_image = "ghcr.io/uzhw8rgl/master-thesis-zk-inference@sha256:978b4857d87f7f9b05328e2e0c6141113a4f5f6d3c78d06cb2de87a7c92de2d1"
# enable_phala_agent = true
# agent_image = "ghcr.io/uzhw8rgl/master-thesis-agent@sha256:2b597425eeebdaeb578aaff9e6db40f456d61cecd1d42678923a02f18585b4e2"
# transparency_log_image = "ghcr.io/uzhw8rgl/master-thesis-transparency-log@sha256:4c6789921d5ff89e546c65c435bc19d479acc8248715dff3f5b1536e2c8af723"
# enable_ollama = true
# ollama_model = "qwen3:0.6b"
# ollama_api_token = "replace-with-at-least-24-url-safe-characters"
# tee_inference_url_override = "https://REPLACE_WITH_TEE_INFERENCE_ENDPOINT"
# zk_inference_url_override = "https://REPLACE_WITH_ZK_INFERENCE_ENDPOINT"
# manage_power_state = true
# desired_power_state = "running" # or "stopped"
# ssh_public_key_path = "/absolute/path/to/id_ed25519.pub"
#
# For multiple workers, prefer phala/tf-env.sh. It builds the sensitive
# additional_workers value in the process environment instead of writing it
# into this file or the command line.
