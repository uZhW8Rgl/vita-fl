# Minimal Phala configuration.
# Defaults already cover:
# - contracts_size = "tdx.small"
# - worker_size    = "tdx.small"
# - region    = "US-WEST-1"
# - os_image  = "dstack-dev-0.5.7"
# - contracts_os_image = null (falls back to os_image)
# - contracts_disk_size = 20
# - contracts_replicas = 1
# - contracts_wait_for_ready = true
# - worker_disk_size    = 20
# - worker_replicas = 1
#
# Keep this file limited to non-secret Terraform overrides. Use phala/tf-env.sh
# for deployment; it supplies every worker identity from the selected
# .env.phala.anvil-style file.

# Optional overrides:
# contracts_app_name = "master-thesis-contract-runtime-phala"
# worker_app_name    = "master-thesis-dfl-worker-0"
# worker_replicas    = 1
# contracts_os_image = "dstack-dev-0.5.9"
# contracts_replicas = 1
# contracts_wait_for_ready = true
# max_dynamic_workers = 6
# initial_dynamic_worker_count = 6
# anvil_account_count = 6
# Owner-controlled AggregationPolicy defaults applied by the Control API before
# worker scaling. These are deliberately absent from Worker Compose.
# client_limit = "5"
# model_submission_deadline_ms = "20000"
# eth_eur_price = "3000"
# eth_usd_price = ""
# exchange_rate_source = "manual_configuration"
# exchange_rate_timestamp_utc = ""
# reference_mainnet_gas_price_gwei = ""
# reference_gas_price_source = ""
# reference_gas_price_timestamp_utc = ""
# worker_image     = "ghcr.io/uzhw8rgl/master-thesis-dfl-worker@sha256:2f28735250cc1c955d7f711f6218fdcbfa6cdacbd5642730bb324ba68e5858e0"
# smart_contracts_image = "ghcr.io/uzhw8rgl/master-thesis-smart-contracts@sha256:d9032aa71bc5a8e297a5a87e7e7ecd122cc8e8d0360e049dadf523cd88e51de8"
# control_api_image = "ghcr.io/uzhw8rgl/master-thesis-control-api@sha256:df3c237de8690c6b418b9d421542bf604d32d20c5596512b2c664132fe1e9597"
# ui_image = "ghcr.io/uzhw8rgl/master-thesis-ui@sha256:cfa6bf74771b4b16e3bf928ff9f3d7066e924ec728875dbc05cda9e312389a22"
# ui_basic_auth_username = "operator"
# ui_basic_auth_password = "replace-with-at-least-16-characters"
# expected_gm_storage_address = "0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"
# expected_device_registry_address = "0x5FbDB2315678afecb367f032d93F642f64180aa3"
# expected_chain_id = 31337
# expected_aggregator_address = "0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512"
# expected_medical_signer_registry_address = "0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9"
# enable_zk_inference = true
# zk_inference_image = "ghcr.io/uzhw8rgl/master-thesis-zk-inference@sha256:3563b261372f23731e7f36287a6562f03f22d40b1524145408a05345fd6c1462"
# zk_inference_size = "tdx.medium"
# enable_phala_agent = true
# agent_image = "ghcr.io/uzhw8rgl/master-thesis-agent@sha256:337df28644a1db406cd34963cd0007e46266b3146333a911a6e3b76715ed96d3"
# transparency_log_image = "ghcr.io/uzhw8rgl/master-thesis-transparency-log@sha256:4c6789921d5ff89e546c65c435bc19d479acc8248715dff3f5b1536e2c8af723"
# enable_ollama = true
# ollama_model = "qwen3:1.7b"
# ollama_size = "tdx.medium"
# ollama_api_token = "replace-with-at-least-24-url-safe-characters"
# Normally leave this unset: the agent discovers Worker 0's REPORTDATA-bound
# HTTPS inference endpoint from DeviceRegistry. This override is for explicit
# diagnostics or a deliberately external compatibility endpoint only.
# tee_inference_url_override = "https://REPLACE_WITH_TEE_INFERENCE_ENDPOINT"
# zk_inference_url_override = "https://REPLACE_WITH_ZK_INFERENCE_ENDPOINT"
# enable_sello_receipts = true
# sello_scitt_url = "https://REPLACE_WITH_CONTRACT_RUNTIME_APP_ID-8000s.dstack-PHALA_REGION.phala.network"
# manage_power_state = true
# desired_power_state = "running" # or "stopped"
# ssh_public_key_path = "/absolute/path/to/id_ed25519.pub"
#
# For dynamic workers, use phala/tf-env.sh. The selected Phala env file is the
# sole source for all W0-W499 Ethereum identities. Participant RSA keys are
# generated inside each worker TEE and are not Terraform inputs. Sensitive
# inventory chunks are written only to a temporary, mode-0600 auto tfvars file
# and removed when Terraform exits.
