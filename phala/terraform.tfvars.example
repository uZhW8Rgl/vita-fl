# Minimal Phala configuration.
# Defaults already cover:
# - contracts_size = "tdx.small"
# - worker_size    = "tdx.small"
# - region    = "US-WEST-1"
# - os_image  = "dstack-dev-0.5.7-9b6a5239"
# - contracts_disk_size = 20
# - worker_disk_size    = 20
# - worker_replicas = 1

account_address    = "0xYOUR_WORKER_ADDRESS"
private_key        = "0xYOUR_WORKER_PRIVATE_KEY"

# Optional overrides:
# contracts_app_name = "master-thesis-contract-runtime-phala"
# worker_app_name    = "master-thesis-dfl-worker-0"
# worker_replicas    = 1
# worker_image     = "ghcr.io/uzhw8rgl/master-thesis-dfl-worker@sha256:..."
# smart_contracts_image = "ghcr.io/uzhw8rgl/master-thesis-smart-contracts@sha256:2d9c1bfb80957f4ed39cee932a965dcfd10db7acf08c0b42f0cf4802fb78d172"
# Legacy fallback only; preferred Phala path verifies the live compose-hash payload.
# phala_rtmr3_event_digests = "worker0_compose_digest,worker1_compose_digest,worker2_compose_digest"
# manage_power_state = true
# desired_power_state = "running" # or "stopped"
# ssh_public_key_path = "/absolute/path/to/id_ed25519.pub"
#
# To add separate worker apps with different account/key pairs:
# additional_workers = {
#   worker1 = {
#     app_name        = "master-thesis-dfl-worker-1"
#     account_address = "0x..."
#     private_key     = "0x..."
#   }
#   worker2 = {
#     app_name        = "master-thesis-dfl-worker-2"
#     account_address = "0x..."
#     private_key     = "0x..."
#   }
# }
