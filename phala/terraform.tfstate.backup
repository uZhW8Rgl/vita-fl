            "disk_size": 20,
            "docker_compose": "services:\n  anvil:\n    image: ghcr.io/foundry-rs/foundry:nightly-dd0a687aa36ec731b6ea2cda2aa4f32e192814fa\n    restart: unless-stopped\n    command:\n      - anvil\n      - --host\n      - 0.0.0.0\n      - --quiet\n      - --accounts\n      - \"20\"\n      - --hardfork\n      - osaka\n      - --code-size-limit\n      - \"999999\"\n    ports:\n      - \"8545:8545\"\n\n  ipfs:\n    image: ipfs/kubo:latest\n    restart: unless-stopped\n    environment:\n      IPFS_TELEMETRY: \"off\"\n    ports:\n      - \"5001:5001\"\n      - \"8080:8080\"\n\n  smart-contracts:\n    image: ghcr.io/uzhw8rgl/master-thesis-smart-contracts:latest\n    restart: \"no\"\n    depends_on:\n      - anvil\n      - ipfs\n    environment:\n      DOCKER: phala\n      RPC_URL: http://anvil:8545\n      KUBO_API_URL: http://ipfs:5001\n      IPFS_PROVIDER: kubo\n      KEEP_ALIVE: \"0\"\n      PCCS_FMSPC: \"20A06F000000\"\n      PCCS_FETCH: \"1\"\n      PCCS_TEE: \"tdx\"\n      P256_MODE: \"native\"\n      DEPLOY_TDX_V4_DCAP: \"1\"\n      VERIFY_TDX_QUOTE_ONCHAIN: \"1\"\n      AGGREGATOR_TIMEOUT_REPORT_PERCENT: \"50\"\n      PCCS_QUOTE_PATH: /dfl/data/phala_tdx_quote\n      TDX_REFERENCE_QUOTE_PATH: /dfl/data/phala_tdx_quote\n      PHALA_COMPOSE_PATH: /dfl/phala/dstack-compose.template.yml\n      PHALA_APP_CODE_PATH: /dfl/phala/app_code.txt\n      PHALA_RTMR3_EVENT_LOG_PATH: /dfl/phala/rtmr3_event_log.txt\n      DATASET_NAME: \"mnist\"\n      W0_ACCOUNT_ADDRESS: \"0x561c6C160021EBfD0810F013f4efCa24edB7e9E3\"\n      W1_ACCOUNT_ADDRESS: \"0x561c6C160021EBfD0810F013f4efCa24edB7e9E3\"\n      INITIAL_GM_SIGNER_ADDRESS: \"0x561c6C160021EBfD0810F013f4efCa24edB7e9E3\"\n    command: [\"bash\", \"/dfl/smart_contracts/starter_docker.sh\"]\n",
