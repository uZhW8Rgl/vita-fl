            "disk_size": 20,
            "docker_compose": "services:\n  anvil:\n    image: ghcr.io/foundry-rs/foundry:nightly-dd0a687aa36ec731b6ea2cda2aa4f32e192814fa\n    restart: unless-stopped\n    environment:\n      ANVIL_IP_ADDR: \"0.0.0.0\"\n      FOUNDRY_DISABLE_NIGHTLY_WARNING: \"1\"\n    entrypoint:\n      - anvil\n    command:\n      - --quiet\n      - --accounts\n      - \"20\"\n      - --hardfork\n      - osaka\n      - --code-size-limit\n      - \"999999\"\n    ports:\n      - \"8545:8545\"\n    healthcheck:\n      test: [\"CMD\", \"cast\", \"chain-id\", \"--rpc-url\", \"http://127.0.0.1:8545\"]\n      interval: 5s\n      timeout: 3s\n      retries: 24\n\n  ipfs:\n    image: ipfs/kubo:latest\n    restart: unless-stopped\n    environment:\n      IPFS_TELEMETRY: \"off\"\n    ports:\n      - \"5001:5001\"\n      - \"8080:8080\"\n    healthcheck:\n      test: [\"CMD\", \"ipfs\", \"id\"]\n      interval: 5s\n      timeout: 5s\n      retries: 24\n\n  smart-contracts:\n    image: ghcr.io/uzhw8rgl/master-thesis-smart-contracts@sha256:ecca24e8dbafbf978acdad4941b25611994d734c2087cc603399e4a44e42540f\n    restart: \"no\"\n    depends_on:\n      anvil:\n        condition: service_healthy\n      ipfs:\n        condition: service_healthy\n    environment:\n      DOCKER: phala\n      BLOCKCHAIN_PROVIDER: \"anvil\"\n      RPC_URL: http://anvil:8545\n      KUBO_API_URL: http://ipfs:5001\n      IPFS_PROVIDER: kubo\n      KEEP_ALIVE: \"0\"\n      ETH_WALLET_PRIVATE_KEY: \"\"\n      INITIAL_GM_CID: \"bafybeigjcypobmn3zna5tlaohmfydpdb7tgzges2mrh7l2er42uja4zj6a\"\n      INITIAL_GM_SIG_CID: \"bafkreib3cdvk7qgy6xq6f3ytakiqu3xytarazl4jnyu2pj3m3rzhr6w4ty\"\n      ETH_EUR_PRICE: \"3000\"\n      TRANSACTION_COST_CSV: \"/dfl/data/evaluation/transaction_costs.csv\"\n      PCCS_FMSPC: \"20A06F000000\"\n      PCCS_FETCH: \"1\"\n      PCCS_TEE: \"tdx\"\n      P256_MODE: \"fallback\"\n      P256_VERIFIER_ADDRESS: \"\"\n      DEPLOY_TDX_V4_DCAP: \"1\"\n      VERIFY_TDX_QUOTE_ONCHAIN: \"1\"\n      AGGREGATOR_TIMEOU