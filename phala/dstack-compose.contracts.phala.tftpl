services:
  anvil:
    image: ${anvil_image}
    restart: unless-stopped
    environment:
      ANVIL_IP_ADDR: "0.0.0.0"
      FOUNDRY_DISABLE_NIGHTLY_WARNING: "1"
    entrypoint:
      - anvil
    command:
      - --quiet
      - --accounts
      - "20"
      - --hardfork
      - osaka
      - --code-size-limit
      - "999999"
      - --gas-limit
      - "1000000000"
    healthcheck:
      test: ["CMD", "cast", "chain-id", "--rpc-url", "http://127.0.0.1:8545"]
      interval: 5s
      timeout: 3s
      retries: 24

  rpc-proxy:
    image: ${smart_contracts_image}
    restart: unless-stopped
    read_only: true
    cap_drop: ["ALL"]
    security_opt: ["no-new-privileges:true"]
    depends_on:
      anvil:
        condition: service_healthy
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      RPC_PROXY_UPSTREAM: http://anvil:8545
    command: ["python3", "/dfl/smart_contracts/rpc_proxy.py"]
    ports:
      - "8545:8545"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8545/health', timeout=2).read()"]
      interval: 5s
      timeout: 3s
      retries: 24

  ipfs:
    image: ${ipfs_image}
    restart: unless-stopped
    environment:
      IPFS_TELEMETRY: "off"
    ports:
      - "5001:5001"
      - "8080:8080"
    healthcheck:
      test: ["CMD", "ipfs", "id"]
      interval: 5s
      timeout: 5s
      retries: 24

  smart-contracts:
    image: ${smart_contracts_image}
    restart: "no"
    depends_on:
      anvil:
        condition: service_healthy
      ipfs:
        condition: service_healthy
    environment:
      DOCKER: phala
      BLOCKCHAIN_PROVIDER: "${blockchain_provider}"
      RPC_URL: http://anvil:8545
      KUBO_API_URL: http://ipfs:5001
      IPFS_PROVIDER: kubo
      KEEP_ALIVE: "${keep_alive}"
      # Supplied through Phala's encrypted app environment. Only allow-list
      # names belong in the measured compose policy.
      ETH_WALLET_PRIVATE_KEY: "$${ETH_WALLET_PRIVATE_KEY}"
      INITIAL_GM_SIGNING_KEY: "$${INITIAL_GM_SIGNING_KEY}"
      INITIAL_BOOTSTRAP_RECIPIENT_PUBLIC_KEY: "$${INITIAL_BOOTSTRAP_RECIPIENT_PUBLIC_KEY}"
      INITIAL_GM_CID: "${initial_gm_cid}"
      INITIAL_GM_SIG_CID: "${initial_gm_sig_cid}"
      ETH_EUR_PRICE: "${eth_eur_price}"
      TRANSACTION_COST_CSV: "${transaction_cost_csv}"
      PCCS_FMSPC: "${pccs_fmspc}"
      PCCS_FETCH: "${pccs_fetch}"
      PCCS_TEE: "${pccs_tee}"
      P256_MODE: "${p256_mode}"
      P256_VERIFIER_ADDRESS: "${p256_verifier_address}"
      DEPLOY_TDX_V4_DCAP: "${deploy_tdx_v4_dcap}"
      VERIFY_TDX_QUOTE_ONCHAIN: "${verify_tdx_quote_onchain}"
      AGGREGATOR_TIMEOUT_REPORT_PERCENT: "${aggregator_timeout_report_percent}"
      EXPECTED_WORKER_IMAGE: "${worker_image}"
      MODEL_TRANSFER_TIMEOUT_MS: "${model_transfer_timeout_ms}"
      MODEL_TRANSFER_RETRY_DELAY_MS: "${model_transfer_retry_delay_ms}"
      PCCS_QUOTE_PATH: "${pccs_quote_path}"
      TDX_QUOTE_PATH: "${tdx_quote_path}"
      TDX_REFERENCE_QUOTE_PATH: "${tdx_reference_quote_path}"
      DATASET_NAME: "${dataset_name}"
      W0_ACCOUNT_ADDRESS: "${w0_account_address}"
      W1_ACCOUNT_ADDRESS: "${w1_account_address}"
      WORKER_ACCOUNT_ADDRESSES: "${worker_account_addresses}"
      WORKER_ACCOUNT_BALANCE_WEI: "10000000000000000000000"
      FUND_WORKER_ACCOUNTS: "0"
      PREAUTHORIZE_WORKER_REGISTRATIONS: "0"
      INITIAL_GM_SIGNER_ADDRESS: "${initial_gm_signer_address}"
    command: ["bash", "/dfl/smart_contracts/starter_docker.sh"]

%{ if enable_control_api ~}
  control-api:
    image: ${control_api_image}
    restart: unless-stopped
    working_dir: /app
    ports:
      - "8091:8091"
    environment:
      CONTROL_RUNTIME_MODE: phala
      CONTROL_API_PORT: "8091"
      PYTHONPATH: /app
      CONTROL_ADMIN_TOKEN: "$${CONTROL_ADMIN_TOKEN}"
      PHALA_CLOUD_API_KEY: "$${PHALA_CLOUD_API_KEY}"
      DYNAMIC_WORKER_INVENTORY: "$${DYNAMIC_WORKER_INVENTORY}"
      REGISTRATION_OWNER_PRIVATE_KEY: "$${REGISTRATION_OWNER_PRIVATE_KEY}"
      DYNAMIC_WORKER_IMAGE: "${worker_image}"
      DYNAMIC_WORKER_RPC_URL: "${dynamic_worker_rpc_url}"
      DYNAMIC_WORKER_KUBO_API_URL: "${dynamic_worker_kubo_api_url}"
      DYNAMIC_WORKER_KUBO_GATEWAY_URL: "${dynamic_worker_kubo_gateway_url}"
      MAX_DYNAMIC_WORKERS: "${max_dynamic_workers}"
      WORKER_COUNT: "${max_dynamic_workers}"
      PHALA_REGION: "${region}"
      PHALA_OS_IMAGE: "${os_image}"
      CLIENT_LIMIT: "${client_limit}"
      EPOCH: "${epoch}"
      ROUND: "${round}"
      MODEL_SUBMISSION_DEADLINE_MS: "${model_submission_deadline_ms}"
      GM_UPDATE_TIMEOUT_MS: "${gm_update_timeout_ms}"
      GM_UPDATE_TIMEOUT_LOOPS: "${gm_update_timeout_loops}"
      AGGREGATION_UPDATE_ESTIMATE_MS: "${aggregation_update_estimate_ms}"
      GM_UPDATE_POLL_MS: "${gm_update_poll_ms}"
      DATASET_NAME: "${dataset_name}"
      TRAIN_IMAGES_SRC: "${train_images_src}"
      TRAIN_LABELS_SRC: "${train_labels_src}"
      TEST_IMAGES_SRC: "${test_images_src}"
      TEST_LABELS_SRC: "${test_labels_src}"
      TRAIN_DATA_SRC: "${train_data_src}"
      TEST_DATA_SRC: "${test_data_src}"
      PYTHON_SERVICE_URL: "${python_service_url}"
      PUBLIC_IP: "${public_ip}"
      MSG_BROKER_IP: "${msg_broker_ip}"
    tmpfs:
      - /run/master-thesis:size=64m,mode=0700
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8091/docs"]
      interval: 10s
      timeout: 5s
      retries: 30
%{ endif ~}

%{ if enable_ui ~}
  ui:
    image: ${ui_image}
    restart: unless-stopped
    depends_on:
      control-api:
        condition: service_healthy
    environment:
      CONTROL_ADMIN_TOKEN: "$${CONTROL_ADMIN_TOKEN}"
      GRAFANA_EXTERNAL_DASHBOARD_URL: ""
      GRAFANA_CONTRACT_DASHBOARD_URL: ""
      GRAFANA_TRAINING_DASHBOARD_URL: ""
      GRAFANA_AGENT_DASHBOARD_URL: ""
    ports:
      - "8088:8080"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/ui-health"]
      interval: 10s
      timeout: 5s
      retries: 30
%{ endif ~}
