services:
  anvil:
    image: ${anvil_image}
    restart: unless-stopped
    environment:
      ANVIL_IP_ADDR: "0.0.0.0"
      FOUNDRY_DISABLE_NIGHTLY_WARNING: "1"
    entrypoint:
      - anvil
    command:
      - --quiet
      - --accounts
      - "${anvil_account_count}"
      - --hardfork
      - osaka
      - --code-size-limit
      - "999999"
      - --gas-limit
      - "1000000000"
    healthcheck:
      test: ["CMD", "cast", "chain-id", "--rpc-url", "http://127.0.0.1:8545"]
      interval: 5s
      timeout: 3s
      retries: 24

  rpc-proxy:
    image: ${smart_contracts_image}
    restart: unless-stopped
    read_only: true
    cap_drop: ["ALL"]
    security_opt: ["no-new-privileges:true"]
    depends_on:
      anvil:
        condition: service_healthy
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      RPC_PROXY_UPSTREAM: http://anvil:8545
    command: ["python3", "/dfl/smart_contracts/rpc_proxy.py"]
    ports:
      - "8545:8545"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8545/health', timeout=2).read()"]
      interval: 5s
      timeout: 3s
      retries: 24

  ipfs:
    image: ${ipfs_image}
    restart: unless-stopped
    environment:
      IPFS_TELEMETRY: "off"
    tmpfs:
      - /data/ipfs:size=512m,mode=0755
    ports:
      - "5001:5001"
      - "8080:8080"
    healthcheck:
      test: ["CMD", "ipfs", "id"]
      interval: 5s
      timeout: 5s
      start_period: 30s
      retries: 24

  smart-contracts:
    image: ${smart_contracts_image}
    restart: "no"
    depends_on:
      anvil:
        condition: service_healthy
      ipfs:
        condition: service_healthy
    environment:
      DOCKER: phala
      BLOCKCHAIN_PROVIDER: "${blockchain_provider}"
      RPC_URL: http://anvil:8545
      KUBO_API_URL: http://ipfs:5001
      IPFS_PROVIDER: kubo
      KEEP_ALIVE: "${keep_alive}"
      # Supplied through Phala's encrypted app environment. Only allow-list
      # names belong in the measured compose policy.
      ETH_WALLET_PRIVATE_KEY: "$${ETH_WALLET_PRIVATE_KEY}"
      INITIAL_GM_SIGNING_KEY: "$${INITIAL_GM_SIGNING_KEY}"
      INITIAL_BOOTSTRAP_RECIPIENT_PUBLIC_KEY: "$${INITIAL_BOOTSTRAP_RECIPIENT_PUBLIC_KEY}"
      DYNAMIC_WORKER_INVENTORY: "$${DYNAMIC_WORKER_INVENTORY}"
${dynamic_worker_inventory_environment}
      INITIAL_GM_CID: "${initial_gm_cid}"
      INITIAL_GM_SIG_CID: "${initial_gm_sig_cid}"
      ETH_EUR_PRICE: "${eth_eur_price}"
      TRANSACTION_COST_CSV: "${transaction_cost_csv}"
      PCCS_FMSPC: "${pccs_fmspc}"
      PCCS_FETCH: "${pccs_fetch}"
      PCCS_TEE: "${pccs_tee}"
      P256_MODE: "${p256_mode}"
      P256_VERIFIER_ADDRESS: "${p256_verifier_address}"
      DEPLOY_TDX_V4_DCAP: "${deploy_tdx_v4_dcap}"
      VERIFY_TDX_QUOTE_ONCHAIN: "${verify_tdx_quote_onchain}"
      AGGREGATOR_TIMEOUT_REPORT_PERCENT: "${aggregator_timeout_report_percent}"
      EXPECTED_WORKER_IMAGE: "${worker_image}"
      MODEL_TRANSFER_TIMEOUT_MS: "${model_transfer_timeout_ms}"
      MODEL_TRANSFER_RETRY_DELAY_MS: "${model_transfer_retry_delay_ms}"
      PCCS_QUOTE_PATH: "${pccs_quote_path}"
      TDX_QUOTE_PATH: "${tdx_quote_path}"
      TDX_REFERENCE_QUOTE_PATH: "${tdx_reference_quote_path}"
      DATASET_NAME: "${dataset_name}"
      W0_ACCOUNT_ADDRESS: "${w0_account_address}"
      W1_ACCOUNT_ADDRESS: "${w1_account_address}"
      WORKER_ACCOUNT_ADDRESSES: "${worker_account_addresses}"
      WORKER_ACCOUNT_BALANCE_WEI: "10000000000000000000000"
      FUND_WORKER_ACCOUNTS: "0"
      INITIAL_GM_SIGNER_ADDRESS: "${initial_gm_signer_address}"
    volumes:
      - evaluation-data:/dfl/data/evaluation
      - runtime-logs:/runtime-logs
    command:
      - bash
      - -c
      - |
        rm -f '${transaction_cost_csv}'
        mkdir -p /runtime-logs
        : > /runtime-logs/smart-contracts.log
        exec > >(tee -a /runtime-logs/smart-contracts.log) 2>&1
        exec bash /dfl/smart_contracts/starter_docker.sh

%{ if enable_control_api ~}
  control-api:
    image: ${control_api_image}
    restart: unless-stopped
    working_dir: /app
    ports:
      - "8091:8091"
    environment:
      CONTROL_RUNTIME_MODE: phala
      TRAINING_WORKSPACE_ROOT: /workspace
      TRAINING_CONFIG_FILE: /run/master-thesis/training.env
      CONTROL_API_PORT: "8091"
      PHALA_OBSERVABILITY_AVAILABLE: "1"
      PHALA_AGENT_AVAILABLE: "${agent_available}"
      PYTHONPATH: /app
      CONTROL_ADMIN_TOKEN: "$${CONTROL_ADMIN_TOKEN}"
      PHALA_CLOUD_API_KEY: "$${PHALA_CLOUD_API_KEY}"
      DYNAMIC_WORKER_INVENTORY: "$${DYNAMIC_WORKER_INVENTORY}"
${dynamic_worker_inventory_environment}
      DYNAMIC_WORKER_IMAGE: "${worker_image}"
      DYNAMIC_WORKER_RPC_URL: "${dynamic_worker_rpc_url}"
      DYNAMIC_WORKER_KUBO_API_URL: "${dynamic_worker_kubo_api_url}"
      DYNAMIC_WORKER_KUBO_GATEWAY_URL: "${dynamic_worker_kubo_gateway_url}"
      DYNAMIC_WORKER_EXPECTED_DEVICE_REGISTRY_ADDRESS: "${expected_device_registry_address}"
      DYNAMIC_WORKER_EXPECTED_AGGREGATOR_ADDRESS: "${expected_aggregator_address}"
      DYNAMIC_WORKER_EXPECTED_GM_STORAGE_ADDRESS: "${expected_gm_storage_address}"
      DYNAMIC_WORKER_EXPECTED_MEDICAL_SIGNER_REGISTRY_ADDRESS: "${expected_medical_signer_registry_address}"
      DYNAMIC_WORKER_EXPECTED_CHAIN_ID: "${expected_chain_id}"
      MAX_DYNAMIC_WORKERS: "${max_dynamic_workers}"
      WORKER_COUNT: "${initial_dynamic_worker_count}"
      PHALA_REGION: "${region}"
      PHALA_OS_IMAGE: "${os_image}"
      CLIENT_LIMIT: "${client_limit}"
      EPOCH: "${epoch}"
      ROUND: "${round}"
      MODEL_SUBMISSION_DEADLINE_MS: "${model_submission_deadline_ms}"
      GM_UPDATE_TIMEOUT_MS: "${gm_update_timeout_ms}"
      GM_UPDATE_TIMEOUT_LOOPS: "${gm_update_timeout_loops}"
      AGGREGATION_UPDATE_ESTIMATE_MS: "${aggregation_update_estimate_ms}"
      GM_UPDATE_POLL_MS: "${gm_update_poll_ms}"
      DATASET_NAME: "${dataset_name}"
      TRAIN_IMAGES_SRC: "${train_images_src}"
      TRAIN_LABELS_SRC: "${train_labels_src}"
      TEST_IMAGES_SRC: "${test_images_src}"
      TEST_LABELS_SRC: "${test_labels_src}"
      TRAIN_DATA_SRC: "${train_data_src}"
      TEST_DATA_SRC: "${test_data_src}"
      PYTHON_SERVICE_URL: "${python_service_url}"
      PUBLIC_IP: "${public_ip}"
      MSG_BROKER_IP: "${msg_broker_ip}"
    volumes:
      - evaluation-data:/workspace/data/evaluation
      - dynamic-worker-state:/run/master-thesis
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8091/docs"]
      interval: 10s
      timeout: 5s
      retries: 30
%{ endif ~}

%{ if enable_agent ~}
  transparency-log:
    image: ${transparency_log_image}
    restart: unless-stopped
    ports:
      - "8000:8000"
    environment:
      SCITT_DATA_DIR: /data
      SCITT_HOST: 0.0.0.0
      SCITT_PORT: "8000"
      PYTHONUNBUFFERED: "1"
    tmpfs:
      - /data:size=512m,mode=0700
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "--insecure", "https://127.0.0.1:8000/node/network"]
      interval: 10s
      timeout: 5s
      start_period: 30s
      retries: 30

  agent:
    image: ${agent_image}
    restart: unless-stopped
    working_dir: /app
    depends_on:
      anvil:
        condition: service_healthy
      ipfs:
        condition: service_healthy
      transparency-log:
        condition: service_healthy
    environment:
      DOCKER: "1"
      PYTHONUNBUFFERED: "1"
      DATASET_NAME: "${dataset_name}"
      RPC_URL: http://anvil:8545
      IPFS_API_URL: http://ipfs:5001
      GM_STORAGE_ADDRESS: "0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"
      REGISTRY_ADDRESS: "0x5FbDB2315678afecb367f032d93F642f64180aa3"
      ACCOUNT_ADDRESS: "${w0_account_address}"
      RSA_PRIVATE_KEY: "$${AGENT_RSA_PRIVATE_KEY}"
      RSA_PUBLIC_KEY: "$${AGENT_RSA_PUBLIC_KEY}"
      OLLAMA_BASE_URL: "${ollama_base_url}"
      OLLAMA_MODEL: "${ollama_model}"
      OLLAMA_API_TOKEN: "$${OLLAMA_API_TOKEN}"
      OLLAMA_NUM_PREDICT: "256"
      OLLAMA_NUM_CTX: "4096"
      AGENT_CHAT_TIMEOUT_SECONDS: "600"
      AGENT_PORT: "8089"
      AGENT_DOWNLOAD_DIR: /tmp/agent-downloads
      TEE_INFERENCE_URL: "${tee_inference_url}"
      ZK_INFERENCE_URL: "${zk_inference_url}"
      TEE_INFERENCE_IMAGE_DIGEST: "${tee_inference_image_digest}"
      EXPECTED_GM_STORAGE_ADDRESS: "${expected_gm_storage_address}"
      EXPECTED_DEVICE_REGISTRY_ADDRESS: "${expected_device_registry_address}"
      EXPECTED_CHAIN_ID: "${expected_chain_id}"
      EXPECTED_RUNTIME_RPC_URL: "${expected_runtime_rpc_url}"
      TEE_INFERENCE_EVIDENCE_PATH: /tmp/tee-inference/latest-evidence.cbor
      SCITT_URL: https://transparency-log:8000
      SCITT_DEVELOPMENT: "1"
      SCITT_SIGNER_DIR: /tmp/agent-scitt
      SCITT_TRANSPARENT_STATEMENT_PATH: /tmp/tee-inference/latest-transparent-statement.cose
      TRANSPARENCY_INDEX_PATH: /tmp/transparency-log/records.jsonl
      SELLO_REQUIRED: "${sello_required}"
      SELLO_TOKEN_ISSUER_SIGNING_SEED: "$${SELLO_TOKEN_ISSUER_SIGNING_SEED}"
      SELLO_OWNER_HPKE_PRIVATE_KEY: "$${SELLO_OWNER_HPKE_PRIVATE_KEY}"
      SELLO_SERVICE_REGISTRY: "$${SELLO_SERVICE_REGISTRY}"
      SELLO_LOG_URLS: "${sello_scitt_url}"
    command:
      - python
      - agent/run_agent.py
      - --serve
      - --llm
      - --source
      - contract
      - --rpc-url
      - http://anvil:8545
      - --gm-storage-address
      - "0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0"
      - --registry-address
      - "0x5FbDB2315678afecb367f032d93F642f64180aa3"
      - --ipfs-api-url
      - http://ipfs:5001
      - --skip-calibration
    tmpfs:
      - /tmp:size=1024m,mode=1777
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8089/health"]
      interval: 10s
      timeout: 5s
      retries: 60
%{ endif ~}

%{ if enable_ui ~}
  observability-init:
    image: ${control_api_image}
    restart: "no"
    command:
      - sh
      - -c
      - |
        rm -rf /runtime-config/grafana /runtime-config/prometheus
        cp -R /opt/master-thesis-observability/. /runtime-config/
        sed -i 's#/var/lib/grafana/dashboards#/runtime-config/grafana/dashboards#g' /runtime-config/grafana/provisioning/dashboards/dashboards.yml
        chmod -R a+rX /runtime-config
    volumes:
      - observability-config:/runtime-config

  prometheus:
    image: prom/prometheus@sha256:5c435642ca4d8427ca26f4901c11114023004709037880cd7860d5b7176aa731
    restart: unless-stopped
    user: "0"
    depends_on:
      observability-init:
        condition: service_completed_successfully
    command:
      - --config.file=/runtime-config/prometheus/prometheus.yml
      - --storage.tsdb.retention.time=24h
      - --web.enable-remote-write-receiver
      - --log.level=warn
    volumes:
      - observability-config:/runtime-config:ro
    tmpfs:
      - /prometheus:size=1024m,mode=1777

  loki:
    image: grafana/loki@sha256:191d4fdfb7264f16989f0a57f320872620a5a7c2ceeec6229212c4190ec49b86
    restart: unless-stopped
    depends_on:
      observability-init:
        condition: service_completed_successfully
    command:
      - -config.file=/runtime-config/loki/loki.yml
    volumes:
      - observability-config:/runtime-config:ro
    tmpfs:
      - /loki:size=512m,mode=1777

  alloy:
    image: grafana/alloy@sha256:51aeb9d829239345070619dad3edd6873186f913c84f45b365b74574fcb38ec0
    restart: unless-stopped
    depends_on:
      observability-init:
        condition: service_completed_successfully
      loki:
        condition: service_started
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - /runtime-config/alloy/config.alloy
    volumes:
      - observability-config:/runtime-config:ro
      - runtime-logs:/runtime-logs:ro
    tmpfs:
      - /var/lib/alloy:size=128m,mode=1777

  grafana:
    image: grafana/grafana@sha256:62d2b9d20a19714ebfe48d1bb405086081bc602aa053e28cf6d73c7537640dfb
    restart: unless-stopped
    depends_on:
      observability-init:
        condition: service_completed_successfully
      prometheus:
        condition: service_started
      loki:
        condition: service_started
    environment:
      GF_PATHS_PROVISIONING: /runtime-config/grafana/provisioning
      GF_SERVER_ROOT_URL: "%(protocol)s://%(domain)s/grafana/"
      GF_SERVER_SERVE_FROM_SUB_PATH: "true"
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin
      GF_SECURITY_ALLOW_EMBEDDING: "true"
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
      GF_LOG_LEVEL: warn
    volumes:
      - observability-config:/runtime-config:ro
    tmpfs:
      - /var/lib/grafana:size=256m,mode=1777

  ui:
    image: ${ui_image}
    restart: unless-stopped
    depends_on:
      control-api:
        condition: service_healthy
      grafana:
        condition: service_started
    environment:
      CONTROL_ADMIN_TOKEN: "$${CONTROL_ADMIN_TOKEN}"
      UI_BASIC_AUTH_USERNAME: "$${UI_BASIC_AUTH_USERNAME}"
      UI_BASIC_AUTH_PASSWORD: "$${UI_BASIC_AUTH_PASSWORD}"
      GRAFANA_EXTERNAL_DASHBOARD_URL: "/grafana/d/dfl-contract-init-overview/dfl-contract-init-overview?kiosk"
      GRAFANA_CONTRACT_DASHBOARD_URL: "/grafana/d/dfl-contract-init-overview/dfl-contract-init-overview?kiosk"
      GRAFANA_TRAINING_DASHBOARD_URL: "/grafana/d/dfl-training-overview/dfl-training-overview?kiosk"
      GRAFANA_AGENT_DASHBOARD_URL: "/grafana/d/agent-mcp-tool-usage/agent-mcp-tool-usage?kiosk"
    ports:
      - "8088:8080"
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:8080/ui-health"]
      interval: 10s
      timeout: 5s
      retries: 30
%{ endif ~}

volumes:
  dynamic-worker-state:
  evaluation-data:
  observability-config:
  runtime-logs:
