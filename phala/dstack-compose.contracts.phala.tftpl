services:
  anvil:
    image: ${anvil_image}
    restart: unless-stopped
    environment:
      ANVIL_IP_ADDR: "0.0.0.0"
      FOUNDRY_DISABLE_NIGHTLY_WARNING: "1"
    entrypoint:
      - anvil
    command:
      - --quiet
      - --accounts
      - "20"
      - --hardfork
      - osaka
      - --code-size-limit
      - "999999"
      - --gas-limit
      - "1000000000"
    healthcheck:
      test: ["CMD", "cast", "chain-id", "--rpc-url", "http://127.0.0.1:8545"]
      interval: 5s
      timeout: 3s
      retries: 24

  rpc-proxy:
    image: ${smart_contracts_image}
    restart: unless-stopped
    read_only: true
    cap_drop: ["ALL"]
    security_opt: ["no-new-privileges:true"]
    depends_on:
      anvil:
        condition: service_healthy
    environment:
      PYTHONDONTWRITEBYTECODE: "1"
      RPC_PROXY_UPSTREAM: http://anvil:8545
    command: ["python3", "/dfl/smart_contracts/rpc_proxy.py"]
    ports:
      - "8545:8545"
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8545/health', timeout=2).read()"]
      interval: 5s
      timeout: 3s
      retries: 24

  ipfs:
    image: ${ipfs_image}
    restart: unless-stopped
    environment:
      IPFS_TELEMETRY: "off"
    ports:
      - "5001:5001"
      - "8080:8080"
    healthcheck:
      test: ["CMD", "ipfs", "id"]
      interval: 5s
      timeout: 5s
      retries: 24

  smart-contracts:
    image: ${smart_contracts_image}
    restart: "no"
    depends_on:
      anvil:
        condition: service_healthy
      ipfs:
        condition: service_healthy
    environment:
      DOCKER: phala
      BLOCKCHAIN_PROVIDER: "${blockchain_provider}"
      RPC_URL: http://anvil:8545
      KUBO_API_URL: http://ipfs:5001
      IPFS_PROVIDER: kubo
      KEEP_ALIVE: "${keep_alive}"
      # Supplied through Phala's encrypted app environment. Only allow-list
      # names belong in the measured compose policy.
      ETH_WALLET_PRIVATE_KEY: "$${ETH_WALLET_PRIVATE_KEY}"
      INITIAL_GM_SIGNING_KEY: "$${INITIAL_GM_SIGNING_KEY}"
      INITIAL_BOOTSTRAP_RECIPIENT_PUBLIC_KEY: "$${INITIAL_BOOTSTRAP_RECIPIENT_PUBLIC_KEY}"
      INITIAL_GM_CID: "${initial_gm_cid}"
      INITIAL_GM_SIG_CID: "${initial_gm_sig_cid}"
      ETH_EUR_PRICE: "${eth_eur_price}"
      TRANSACTION_COST_CSV: "${transaction_cost_csv}"
      PCCS_FMSPC: "${pccs_fmspc}"
      PCCS_FETCH: "${pccs_fetch}"
      PCCS_TEE: "${pccs_tee}"
      P256_MODE: "${p256_mode}"
      P256_VERIFIER_ADDRESS: "${p256_verifier_address}"
      DEPLOY_TDX_V4_DCAP: "${deploy_tdx_v4_dcap}"
      VERIFY_TDX_QUOTE_ONCHAIN: "${verify_tdx_quote_onchain}"
      AGGREGATOR_TIMEOUT_REPORT_PERCENT: "${aggregator_timeout_report_percent}"
      EXPECTED_WORKER_IMAGE: "${worker_image}"
      MODEL_TRANSFER_TIMEOUT_MS: "${model_transfer_timeout_ms}"
      MODEL_TRANSFER_RETRY_DELAY_MS: "${model_transfer_retry_delay_ms}"
      PCCS_QUOTE_PATH: "${pccs_quote_path}"
      TDX_QUOTE_PATH: "${tdx_quote_path}"
      TDX_REFERENCE_QUOTE_PATH: "${tdx_reference_quote_path}"
      DATASET_NAME: "${dataset_name}"
      W0_ACCOUNT_ADDRESS: "${w0_account_address}"
      W1_ACCOUNT_ADDRESS: "${w1_account_address}"
      WORKER_ACCOUNT_ADDRESSES: "${worker_account_addresses}"
      WORKER_ACCOUNT_BALANCE_WEI: "10000000000000000000000"
      INITIAL_GM_SIGNER_ADDRESS: "${initial_gm_signer_address}"
    command: ["bash", "/dfl/smart_contracts/starter_docker.sh"]
