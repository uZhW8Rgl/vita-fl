services:
  dfl-worker:
    image: ${worker_image}
    restart: unless-stopped
    volumes:
      - /var/run/dstack.sock:/var/run/dstack.sock
      - /var/run/tappd.sock:/var/run/tappd.sock
      - participant-key-state:/var/lib/vita-fl
    tmpfs:
      - /run/vita-fl:size=16m,mode=0700
%{ if inference_enabled ~}
      - /tmp/tee-inference:size=256m,mode=0700
%{ endif ~}
    ports:
      - "8001:8001"
%{ if inference_enabled ~}
      - "8080:8080"
%{ endif ~}
    environment:
      DOCKER: phala
      NODE_ENV: production
      IPFS_PROVIDER: kubo
      KUBO_API: "${kubo_api_url}"
      KUBO_GATEWAY: "${kubo_gateway_url}"
      DSTACK_GATEWAY_DOMAIN: "$${DSTACK_GATEWAY_DOMAIN}"
      PUBLIC_IP: "${public_ip}"
      MSG_BROKER_IP: "${msg_broker_ip}"

      ACCOUNT_ADDRESS: "${account_address}"
      DEVICE_ID: "${device_id}"
      # Values are supplied through Phala's encrypted app environment. Keeping
      # only the names here prevents secrets from entering measured app-compose.
      PRIVATE_KEY: "$${PRIVATE_KEY}"
      PARTICIPANT_KEY_PROVIDER: dstack
      PARTICIPANT_KEY_STATE_PATH: /var/lib/vita-fl/participant-rsa.v1.sealed.json
      PARTICIPANT_PRIVATE_KEY_RUNTIME_PATH: /run/vita-fl/participant-private.pem
      PARTICIPANT_PUBLIC_KEY_RUNTIME_PATH: /run/vita-fl/participant-public.pem
      # Auto-resolved from the contract-runtime TEE's Kubo manifest at
      # /runtime/contracts.json when the worker boots.
      REGISTRY_ADDRESS: ""
      AGGREGATOR_ADDRESS: ""
      GM_STORAGE_ADDRESS: ""
      MEDICAL_SIGNER_REGISTRY_ADDRESS: ""
      EXPECTED_DEVICE_REGISTRY_ADDRESS: "${expected_device_registry_address}"
      EXPECTED_AGGREGATOR_ADDRESS: "${expected_aggregator_address}"
      EXPECTED_GM_STORAGE_ADDRESS: "${expected_gm_storage_address}"
      EXPECTED_MEDICAL_SIGNER_REGISTRY_ADDRESS: "${expected_medical_signer_registry_address}"
      EXPECTED_CHAIN_ID: "${expected_chain_id}"
      RPC_URL: "${rpc_url}"
      ETH_EUR_PRICE: "${eth_eur_price}"
      ETH_USD_PRICE: "${eth_usd_price}"
      EXCHANGE_RATE_SOURCE: "${exchange_rate_source}"
      EXCHANGE_RATE_TIMESTAMP_UTC: "${exchange_rate_timestamp_utc}"
      REFERENCE_MAINNET_GAS_PRICE_GWEI: "${reference_mainnet_gas_price_gwei}"
      REFERENCE_GAS_PRICE_SOURCE: "${reference_gas_price_source}"
      REFERENCE_GAS_PRICE_TIMESTAMP_UTC: "${reference_gas_price_timestamp_utc}"

      EPOCH: "${epoch}"
      ROUND: "${round}"
      DFL_MODEL_SEED: "${dfl_model_seed}"
      DFL_TRAIN_SEED: "${dfl_train_seed}"
      DFL_TRAIN_OPTIMIZER: "${dfl_train_optimizer}"
      DFL_TRAIN_LEARNING_RATE: "${dfl_train_learning_rate}"
      DFL_TRAIN_LR_SCHEDULE: "${dfl_train_lr_schedule}"
      DFL_TRAIN_LR_DECAY_START_ROUND: "${dfl_train_lr_decay_start_round}"
      DFL_TRAIN_LR_FINAL_FACTOR: "${dfl_train_lr_final_factor}"
      DFL_TRAIN_WEIGHT_DECAY: "${dfl_train_weight_decay}"
      DFL_GRAD_CLIP_NORM: "${dfl_grad_clip_norm}"
      DFL_POS_WEIGHT_CAP: "${dfl_pos_weight_cap}"
      GM_UPDATE_TIMEOUT_MS: "${gm_update_timeout_ms}"
      GM_UPDATE_TIMEOUT_LOOPS: "${gm_update_timeout_loops}"
      AGGREGATION_UPDATE_ESTIMATE_MS: "${aggregation_update_estimate_ms}"
      GM_UPDATE_POLL_MS: "${gm_update_poll_ms}"
      WORKER_COUNT: "${worker_count}"
      DATASET_NAME: "${dataset_name}"

      TRAIN_IMAGES_SRC: "${train_images_src}"
      TRAIN_LABELS_SRC: "${train_labels_src}"
      TEST_IMAGES_SRC: "${test_images_src}"
      TEST_LABELS_SRC: "${test_labels_src}"
      TRAIN_DATA_SRC: "${train_data_src}"
      TEST_DATA_SRC: "${test_data_src}"

      PYTHON_SERVICE_URL: "${python_service_url}"
      MODEL_UPLOAD_PORT: "8001"
      DFL_TELEMETRY_URL: ""
      TEE_INFERENCE_ENABLED: "${inference_enabled ? 1 : 0}"
%{ if inference_enabled ~}
      EXPECTED_RUNTIME_RPC_URL: "${rpc_url}"
      TEE_MODEL_DIR: /tmp/tee-inference/model
      TEE_JOB_DIR: /tmp/tee-inference/jobs
      CHESTMNIST_TEST_DATA: /dfl/config/chestmnist/test_data/test-data.npz
      SELLO_REQUIRED: "${sello_required ? 1 : 0}"
      SELLO_SERVICE_SIGNING_SEED: "$${SELLO_SERVICE_SIGNING_SEED}"
      SELLO_TOKEN_ISSUER_PUBLIC_KEY: "$${SELLO_TOKEN_ISSUER_PUBLIC_KEY}"
      SCITT_URL: "${sello_scitt_url}"
      SCITT_DEVELOPMENT: "1"
      SCITT_SIGNER_DIR: /tmp/tee-inference/scitt-signer
      SELLO_PUBLICATION_DIR: /tmp/tee-inference/sello-publications
%{ endif ~}
    command:
      - /bin/bash
      - -lc
      - exec /dfl/start_node_neural_network.sh

volumes:
  participant-key-state:
