            "docker_compose": "services:\n  dfl-worker:\n    # Replace the digest after running the \"Publish DFL Worker Image\" workflow.\n    # The digest-pinned image reference is what becomes part of the measured\n    # Phala/dstack application configuration.\n    image: ghcr.io/uzhw8rgl/master-thesis-dfl-worker@sha256:8d730338ae80a57da47b4d246910b90ad72f9ef48ccd361cf8d9f305626942de\n    restart: unless-stopped\n    environment:\n      DOCKER: phala\n      NODE_ENV: production\n      IPFS_PROVIDER: kubo\n      PUBLIC_IP: \"\"\n      MSG_BROKER_IP: \"\"\n\n      # Runtime configuration for the DFL prototype.\n      ACCOUNT_ADDRESS: \"REPLACE_WITH_WORKER_ADDRESS\"\n      PRIVATE_KEY: \"REPLACE_WITH_WORKER_PRIVATE_KEY\"\n      REGISTRY_ADDRESS: \"REPLACE_WITH_REGISTRY_ADDRESS\"\n      AGGREGATOR_ADDRESS: \"REPLACE_WITH_AGGREGATOR_ADDRESS\"\n      GM_STORAGE_ADDRESS: \"REPLACE_WITH_GM_STORAGE_ADDRESS\"\n      SEPOLIA_RPC_URL: \"REPLACE_WITH_RPC_URL\"\n\n      CLIENT_LIMIT: \"2\"\n      EPOCH: \"1\"\n      ROUND: \"1\"\n      MODEL_SUBMISSION_DEADLINE_MS: \"20000\"\n      GM_UPDATE_TIMEOUT_MS: \"30000\"\n      GM_UPDATE_TIMEOUT_LOOPS: \"2\"\n      AGGREGATION_UPDATE_ESTIMATE_MS: \"30000\"\n      GM_UPDATE_POLL_MS: \"5000\"\n\n      # The image contains demo keys, but production deployments should inject\n      # worker-specific RSA keys through secrets or environment configuration.\n      RSA_PRIVATE_KEY_FILE: /dfl/keys/private_key.pem\n      RSA_PUBLIC_KEY_FILE: /dfl/keys/public_key.pem\n      TRAIN_IMAGES_SRC: /dfl/config/training_data/train-images-0.idx3-ubyte\n      TRAIN_LABELS_SRC: /dfl/config/training_data/train-labels-0.idx1-ubyte\n\n      PYTHON_SERVICE_URL: http://127.0.0.1:8000\n    command: [\"/dfl/start_node_neural_network.sh\"]\n",
