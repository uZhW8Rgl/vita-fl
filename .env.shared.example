PHALA_CLOUD_API_KEY=

# IPFS / artifact settings
API_KEY=
API_SECRET=
PINATA_JWT=
IPFS_PROVIDER=kubo
IPFS_GATEWAY=http://ipfs_local:8080
KUBO_API=http://ipfs_local:5001
KUBO_GATEWAY=http://ipfs_local:8080
IPFS_FETCH_TIMEOUT_MS=30000

# Runtime mode
DOCKER=local
#DOCKER=phala

# Experiment settings
CLIENT_LIMIT=2
MODEL_SUBMISSION_DEADLINE_MS=180000
GM_UPDATE_TIMEOUT_MS=90000
GM_UPDATE_TIMEOUT_LOOPS=4
AGGREGATION_UPDATE_ESTIMATE_MS=90000
GM_UPDATE_POLL_MS=5000
MODEL_TRANSFER_TIMEOUT_MS=20000
MODEL_TRANSFER_RETRY_DELAY_MS=5000
AGGREGATOR_TIMEOUT_REPORT_PERCENT=50
EPOCH=2
ROUND=5
WORKER_COUNT=3
ANVIL_ACCOUNT_COUNT=500
ETH_EUR_PRICE=3000
ETH_USD_PRICE=
EXCHANGE_RATE_SOURCE=manual_configuration
EXCHANGE_RATE_TIMESTAMP_UTC=
REFERENCE_MAINNET_GAS_PRICE_GWEI=
REFERENCE_GAS_PRICE_SOURCE=
REFERENCE_GAS_PRICE_TIMESTAMP_UTC=
DFL_EXPERIMENT_ID=local
DFL_EVAL_WRITE_SAMPLE_METRICS=1
DFL_MODEL_SEED=42
DFL_TRAIN_SEED=42
DFL_TRAIN_OPTIMIZER=adamw
DFL_TRAIN_LEARNING_RATE=0.003
DFL_TRAIN_LR_SCHEDULE=constant
DFL_TRAIN_LR_DECAY_START_ROUND=20
DFL_TRAIN_LR_FINAL_FACTOR=0.25
DFL_TRAIN_WEIGHT_DECAY=0.0001
DFL_GRAD_CLIP_NORM=5
DFL_POS_WEIGHT_CAP=10
DATASET_NAME=chestmnist

# Initial global model
INITIAL_GM_CID=
INITIAL_GM_SIG_CID=
INITIAL_GM_SIGNER_ADDRESS=

# Attestation / quote settings shared by both profiles
ANVIL_HARDFORK=osaka
P256_MODE=native
PCCS_FMSPC=20A06F000000
PCCS_FETCH=1
PCCS_TEE=tdx
PCCS_QUOTE_PATH=../data/phala_tdx_quote
DEPLOY_TDX_V4_DCAP=1
VERIFY_TDX_QUOTE_ONCHAIN=1
KEEP_ALIVE=0
TDX_QUOTE_PATH=./attestation/phala_tdx_quote
TDX_REFERENCE_QUOTE_PATH=../data/phala_tdx_quote

# Worker identities are defined only in .env.phala.anvil and
# .env.phala.anvil.example.
